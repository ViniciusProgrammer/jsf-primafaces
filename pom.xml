<project xmlns="http://apache.org"
	xmlns:xsi="http://w3.org"
	xsi:schemaLocation="http://apache.org https://apache.org">
  <modelVersion>4.0.0</modelVersion>
  
  <groupId>br.ufrn.imd</groupId>
  <artifactId>curso-jsf-primerfaces-essencial</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  
  <packaging>war</packaging>
  
  <name>curso-jsf-primerfaces-essencial</name>
  <description>Curso de Primerfaces</description>

  <properties>
  	<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  
  <dependencies>
  	<!-- JSF: Fornecido nativamente pelo WildFly antigo -->
  	<dependency>
  		<groupId>org.glassfish</groupId>
  		<artifactId>javax.faces</artifactId>
  		<version>2.2.14</version>
  		<scope>provided</scope>	
  	</dependency>
  	
  	<!-- PrimeFaces: Precisa ser empacotado junto ao projeto -->
  	<dependency>
  		<groupId>org.primefaces</groupId>
  		<artifactId>primefaces</artifactId>
  		<version>6.0</version>
  		<scope>compile</scope>
  	</dependency>
  	
  	<!-- Servlet API: Fornecido pelo servidor web -->
  	<dependency>
  		<groupId>javax.servlet</groupId>
  		<artifactId>javax.servlet-api</artifactId>
  		<version>3.1.0</version>
  		<scope>provided</scope>
  	</dependency>
  	
  	<!-- Hibernate Validator: Fornecido pelo ecossistema Java EE 8 do WildFly -->
  	<dependency>
  		<groupId>org.hibernate</groupId>
  		<artifactId>hibernate-validator</artifactId>
  		<version>5.3.2.Final</version>
  		<scope>provided</scope>
  	</dependency>
  	
  	<!-- Hibernate Core: Fornecido pelo WildFly (gerenciador JPA nativo) -->
  	<dependency>
  		<groupId>org.hibernate</groupId>
  		<artifactId>hibernate-core</artifactId>
  		<version>5.2.4.Final</version>
  		<scope>provided</scope>
  	</dependency>
  	
  	<!-- Driver do MySQL: Compilado junto para conexão com o banco de dados -->
  	<dependency>
  		<groupId>mysql</groupId>
  		<artifactId>mysql-connector-java</artifactId>
  		<version>8.0.28</version>
  		<scope>compile</scope>
  	</dependency>
  	
  	<!-- JAXB: Necessário para compatibilidade caso utilize o Java 11 ou superior -->
  	<dependency>
    	<groupId>javax.xml.bind</groupId>
    	<artifactId>jaxb-api</artifactId>
    	<version>2.3.1</version>
	</dependency>
	
	<dependency>
    	<groupId>org.glassfish.jaxb</groupId>
    	<artifactId>jaxb-runtime</artifactId>
    	<version>2.3.1</version>
	</dependency>
	
	<!-- Common Annotations API: Contém a anotação @Priority -->
	<dependency>
	    <groupId>javax.annotation</groupId>
	    <artifactId>javax.annotation-api</artifactId>
	    <version>1.3.2</version>
	</dependency>

	<!-- Interceptor API: Adicionado para garantir o ciclo de vida dos interceptores locais -->
	<dependency>
	    <groupId>javax.interceptor</groupId>
	    <artifactId>javax.interceptor-api</artifactId>
	    <version>1.2.2</version>
	</dependency>

  </dependencies>
  
  <build>
  	<plugins>
  		<plugin>
  			<groupId>org.apache.maven.plugins</groupId>
  			<artifactId>maven-compiler-plugin</artifactId>
  			<version>3.13.0</version>
  			<configuration>
  				<source>1.8</source>
  				<target>1.8</target>
  			</configuration>
  		</plugin>
  	</plugins>
  </build>
</project>
